<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="88dp"
    android:height="88dp"
    android:viewportWidth="88"
    android:viewportHeight="88">

    <!-- Slate note card. Carries its own contrast on both the light and dark auth screens. -->
    <path
        android:fillColor="#314754"
        android:pathData="M26,14H62A10,10 0 0 1 72,24V64A10,10 0 0 1 62,74H26A10,10 0 0 1 16,64V24A10,10 0 0 1 26,14Z" />

    <!-- Gold nib, laid down first so only the tip clears the feather and sits on the card. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M20.3,70L34.55,55"
        android:strokeColor="#CBB981"
        android:strokeLineCap="round"
        android:strokeWidth="4" />

    <!-- Feather. -->
    <path
        android:fillColor="#78E5D5"
        android:pathData="M26,64Q62.4,60.5 64,24Q27.6,27.5 26,64Z" />

    <!-- Quill shaft, drawn in the page colour so it reads as a cut through the feather. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M34.55,55L64,24"
        android:strokeColor="#1B262E"
        android:strokeLineCap="round"
        android:strokeWidth="3" />
</vector>
