<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- API 31+: the system splash carries the approved Memo mark (accent-tinted, padded
         to the in-app proportions) on the same launch background, so the launch window,
         the in-app reveal and Login read as one surface instead of a dark icon chip. -->
    <style name="Theme.Notes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/memo_logo_splash_light</item>
    </style>
</resources>
